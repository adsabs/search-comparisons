# Search Comparisons Local Environment Configuration
# Copy this file to .env.local and fill in your actual API keys

# Application Environment
APP_ENVIRONMENT=local
DEBUG=true

# API Keys - Replace with your actual keys
ADS_API_KEY=your_ads_api_key_here
ADS_API_TOKEN=your_ads_api_token_here
WEB_OF_SCIENCE_API_KEY=your_web_of_science_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here

# Alternative key names (the app will check for these if main keys are missing)
WOS_API_KEY=your_web_of_science_api_key_here
WEBOFSCIENCE_API_KEY=your_web_of_science_api_key_here
WOS_KEY=your_web_of_science_api_key_here

# Database Configuration
DATABASE_URL=sqlite:///./search_comparisons.db

# LLM Configuration
LLM_ENABLED=true
LLM_MODEL_NAME=qwen2:7b
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000
LLM_PROVIDER=ollama
LLM_API_ENDPOINT=http://localhost:11434/api/generate

# Local LLM Configuration
LOCAL_LLM_ENABLED=false
LOCAL_LLM_HOST=localhost
LOCAL_LLM_PORT=11434
LOCAL_LLM_TIMEOUT=120

# Google Scholar Configuration
SCHOLAR_TIMEOUT_SECONDS=30
SCHOLAR_MAX_RETRIES=3
SCHOLAR_RETRY_DELAY=5
SCHOLAR_BLOCK_DELAY=300
SCHOLAR_PROXY_URL=

# Caching Configuration
CACHE_DIR=./cache
CACHE_EXPIRY=86400

# Logging Configuration
LOG_LEVEL=INFO

# Security
SECRET_KEY=your-secret-key-here-change-in-production

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Development/Testing Configuration
QUEPID_API_URL=https://quepid.herokuapp.com/api/
