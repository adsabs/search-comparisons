# Security Configuration for Search Comparisons Backend
# Copy this to .env and configure the values for your environment

# Debug Endpoints Security
# Set to 'true' to enable debug endpoints (DISABLE IN PRODUCTION)
DEBUG_ENDPOINTS_ENABLED=false

# API key required to access debug endpoints (leave empty to disable key auth)
# Generate a strong random key for production use
DEBUG_API_KEY=

# IP addresses allowed to access debug endpoints (comma-separated)
# Use specific IPs/ranges in production, not 0.0.0.0/0
DEBUG_ALLOWED_IPS=127.0.0.1,::1

# CORS Configuration
# Frontend URL for CORS (will be added to allowed origins)
FRONTEND_URL=https://your-frontend-domain.com

# Additional allowed hosts for production (comma-separated)
# Only set in production environment
ALLOWED_HOSTS=your-api-domain.com,your-alternate-domain.com

# Environment setting
ENVIRONMENT=production

# API Keys (keep these secure!)
ADS_API_KEY=your_ads_api_key_here
WEB_OF_SCIENCE_API_KEY=your_wos_api_key_here

# Example production configuration:
# DEBUG_ENDPOINTS_ENABLED=false
# DEBUG_API_KEY=super-secret-debug-key-here
# DEBUG_ALLOWED_IPS=192.168.1.0/24,10.0.0.100
# FRONTEND_URL=https://search.yourcompany.com
# ALLOWED_HOSTS=api.yourcompany.com,search-api.yourcompany.com
# ENVIRONMENT=production
