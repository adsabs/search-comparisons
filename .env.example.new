# Search Comparisons Environment Variables
# Copy this file to .env and fill in your actual values

# Required API Keys
ADS_API_KEY=your_ads_api_key_here
SCIX_DEV_PASSWORD=your_scix_dev_password_here

# Optional API Keys (features will be disabled if not provided)
WEB_OF_SCIENCE_API_KEY=your_web_of_science_api_key_here
SEMANTIC_SCHOLAR_API_KEY=your_semantic_scholar_api_key_here
QUEPID_API_KEY=your_quepid_api_key_here

# Optional Configuration
SCIX_DEV_USERNAME=ads
SCIX_DEV_ENDPOINT=https://playground.adsabs.harvard.edu/dev/solr/collection1/select
QUEPID_API_URL=https://quepid.herokuapp.com/api/

# Database Configuration
DATABASE_URL=sqlite:///./search_comparisons.db

# Application Configuration
LOG_LEVEL=INFO
DEBUG=false
ENVIRONMENT=local
FRONTEND_URL=http://localhost:3001

# LLM Configuration (for query intent service)
USE_LLM=false
LLM_MODEL_NAME=llama3.2:latest
LLM_API_URL=http://localhost:11434
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.1

# ADS Solr Authentication (for experiments)
ADS_SOLR_PASSWORD=your_ads_solr_password_here
